{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/context-graph/entity.schema.json",
  "title": "Context Graph Entity",
  "description": "A typed record in the engineering context graph. The graph stores references and metadata, not source code.",
  "type": "object",
  "required": ["id", "type", "title", "status", "createdAt", "updatedAt"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "type": {
      "type": "string",
      "enum": ["BusinessChange", "Requirement", "EngineeringChange", "Defect", "Incident", "ContextAssessment", "DesignDecision", "Component", "ImplementationIntent", "Verification", "ReadinessGate", "Release", "OperationalAsset", "Feedback", "RallyWorkItem"]
    },
    "title": { "type": "string", "minLength": 1 },
    "summary": { "type": "string" },
    "status": { "type": "string", "minLength": 1 },
    "owner": { "type": ["string", "null"] },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "attributes": { "type": "object", "additionalProperties": true }
  },
  "additionalProperties": false
}

